# ─────────────────────────────────────────────────────────────────────────────
# AutoPeer frontend environment. Copy to `.env` for local dev, or set these in
# the Netlify dashboard (Site settings → Environment variables) for production.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — base URL of your running autopeer-center backend.
# The frontend proxies /api/** to ${API_BASE}/api/** server-side, so the browser
# only ever calls same-origin and this URL never reaches the client bundle.
API_BASE=https://your-center.example.com

# Public site URL (used for absolute links / OG tags).
NUXT_PUBLIC_SITE_URL=https://your-site.example.com

# Branding (optional).
NUXT_PUBLIC_APP_NAME=AutoPeer
NUXT_PUBLIC_OPERATOR=Your Organization

# Pinned Autopeer-Version header sent on every API request (Stripe-style).
# Must be a version the backend knows; see center docs/api/versioning.md.
NUXT_PUBLIC_API_VERSION=2026-06-07

# Build/release marker shown in the footer (set in CI: COMMIT_HASH=$(git rev-parse --short HEAD)).
COMMIT_HASH=dev

# Nitro deploy preset. Leave unset locally (defaults to node-server);
# netlify.toml sets this to "netlify" for production builds.
# NITRO_PRESET=netlify
